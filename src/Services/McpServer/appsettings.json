{
    "Logging": {
        "LogLevel": {
            "Default": "Information"
        }
    },
    "DataSources": {
        "Jaeger": {
            "BaseUrl": "http://jaeger:16686"
        },
        "Kubernetes": {
            "Namespace": "mcp-apis"
        },
        "OpenApiSpecPaths": [
            "/openapi/v1.json",
            "/openapi/v2.json",
            "/swagger/v1/swagger.json",
            "/api/v1/openapi.json",
            "/api-docs/v1.json"
        ]
    },
    "Services": {
        "precoapi": "http://precoapi",
        "produtoapi": "http://produtoapi"
    },
    "Discovery": {
        "Mode": "Config",
        "KubernetesLabel": "mcp-apis/indexed"
    }
}
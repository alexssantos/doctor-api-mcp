{
    "Logging": {
        "LogLevel": {
            "Default": "Information"
        }
    },
    "ClusterAccess": {
        "Scope": "Cluster",
        "ServiceDiscovery": true,
        "StateStorage": "ConfigMap",
        "AllowVolumes": true,
        "ValidateOnStart": true,
        "ValidationCacheSeconds": 30
    },
    "Otel": {
        "Endpoint": "http://jaeger.mcp-apis.svc.cluster.local:4317",
        "CaptureBody": false,
        "MaxCapturedBodyBytes": 16384,
        "AllowedBodyContentTypes": ["application/json", "application/problem+json"]
    },
    "Security": {
        "Authentication": {
            "Enabled": true,
            "HeaderName": "X-Observability-Api-Key"
        },
        "AllowedNamespaces": ["mcp-apis"],
        "AllowedServiceHostSuffixes": [".svc.cluster.local"],
        "AllowedServicePorts": [80, 443, 8080]
    },
    "Observability": {
        "Limits": {
            "DefaultWindowMinutes": 30,
            "MaxWindowMinutes": 1440,
            "ProviderTimeoutSeconds": 10,
            "ToolTimeoutSeconds": 30,
            "MaxTraces": 50,
            "MaxSpans": 1000,
            "MaxLogs": 200,
            "MaxDependencies": 100,
            "MaxGraphDepth": 4,
            "MinimumRangeStepSeconds": 15,
            "MaxResponseBytes": 524288,
            "MaxCapturedBodyBytes": 16384,
            "RateLimitRequestsPerMinute": 120,
            "ConcurrencyLimit": 16
        },
        "Health": {
            "MinimumCoverage": 0.6,
            "HealthyCoverage": 0.8,
            "HealthyScore": 85,
            "DegradedScore": 60,
            "WarningErrorRate": 0.02,
            "CriticalErrorRate": 0.1,
            "WarningP95Milliseconds": 500,
            "CriticalP95Milliseconds": 2000,
            "WarningRestarts": 1,
            "CriticalRestarts": 5
        },
        "Metrics": {
            "ServiceLabel": "job",
            "RequestDurationCountMetric": "http_server_request_duration_seconds_count",
            "RequestDurationBucketMetric": "http_server_request_duration_seconds_bucket",
            "StatusCodeLabel": "http_response_status_code",
            "AvailabilityMetric": "up",
            "CpuMetric": "dotnet_process_cpu_time_seconds_total",
            "MemoryMetric": "dotnet_process_memory_working_set_bytes"
        },
        "Cache": {
            "HealthTtlSeconds": 20,
            "DependencyTtlSeconds": 120,
            "SpecTtlSeconds": 900,
            "KubernetesTtlSeconds": 20
        },
        "Features": {
            "EnableRawQueries": false,
            "EnableLogs": true,
            "EnableDeploymentEvents": true
        }
    },
    "DataSources": {
        "Jaeger": {
            "BaseUrl": "http://jaeger.mcp-apis.svc.cluster.local:16686"
        },
        "Prometheus": {
            "BaseUrl": "http://prometheus.mcp-apis.svc.cluster.local:9090"
        },
        "Loki": {
            "BaseUrl": "http://loki.mcp-apis.svc.cluster.local:3100"
        },
        "Kubernetes": {
            "Namespace": "mcp-apis"
        },
        "OpenApiSpecPaths": [
            "/openapi/v1.json",
            "/openapi/v2.json",
            "/swagger/v1/swagger.json",
            "/api/v1/openapi.json",
            "/api-docs/v1.json"
        ]
    },
    "Services": {},
    "Discovery": {
        "Mode": "Auto",
        "KubernetesLabel": "mcp-apis/indexed",
        "RescanSeconds": 60,
        "RevalidateSeconds": 300,
        "ForgetAfterMinutes": 60,
        "StateConfigMap": "mcpserver-state",
        "ExcludeNamespaces": ["kube-system", "kube-public", "kube-node-lease"],
        "ExcludeApps": ["mcpserver", "jaeger", "prometheus", "grafana", "loki", "promtail", "postgres-preco", "postgres-produto", "kubernetes"],
        "ExcludeOtelServices": ["jaeger-query", "McpServer"]
    },
    "Dashboard": {
        "Links": {
            "Jaeger": "http://jaeger.local:8080",
            "Prometheus": "http://prometheus.local:8080",
            "Grafana": "http://grafana.local:8080"
        }
    }
}

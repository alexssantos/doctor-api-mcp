{
    "Logging": {
        "LogLevel": {
            "Default": "Information"
        }
    },
    "Otel": {
        "Endpoint": "http://jaeger.mcp-apis.svc.cluster.local:4317",
        "CaptureBody": false
    },
    "DataSources": {
        "Jaeger": {
            "BaseUrl": "http://jaeger.mcp-apis.svc.cluster.local:16686"
        },
        "Prometheus": {
            "BaseUrl": "http://prometheus.mcp-apis.svc.cluster.local:9090"
        },
        "Kubernetes": {
            "Namespace": "mcp-apis"
        },
        "OpenApiSpecPaths": [
            "/openapi/v1.json",
            "/openapi/v2.json",
            "/swagger/v1/swagger.json",
            "/api/v1/openapi.json",
            "/api-docs/v1.json"
        ]
    },
    "Services": {
        "precoapi": "http://precoapi.mcp-apis.svc.cluster.local",
        "produtoapi": "http://produtoapi.mcp-apis.svc.cluster.local"
    },
    "Discovery": {
        "Mode": "Config",
        "KubernetesLabel": "mcp-apis/indexed"
    },
    "Dashboard": {
        "Links": {
            "Jaeger": "http://jaeger.local:8080",
            "Prometheus": "http://prometheus.local:8080",
            "Grafana": "http://grafana.local:8080"
        }
    }
}